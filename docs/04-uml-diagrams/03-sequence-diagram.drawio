        <!-- Messages -->
        <mxCell id="m1" value="1. Ворид кардани маълумоти воридшавӣ" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="230" as="sourcePoint"/><mxPoint x="435" y="230" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m2" value="2. POST /api/login" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="270" as="sourcePoint"/><mxPoint x="745" y="270" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m3" value="3. Санҷиши корбар ва парол" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="310" as="sourcePoint"/><mxPoint x="1070" y="310" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4" value="4. Маълумоти корбар" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="350" as="sourcePoint"/><mxPoint x="745" y="350" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5" value="5. Ҷавоби муваффақ / иҷозати дастрасӣ" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="390" as="sourcePoint"/><mxPoint x="435" y="390" as="targetPoint"/></mxGeometry></mxCell>
