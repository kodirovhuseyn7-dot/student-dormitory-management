        <mxCell id="m7" value="7. Ирсоли дархост" style="endArrow=block;html=1;rounded=0;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="470" as="sourcePoint"/><mxPoint x="745" y="470" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m8" value="8. Санҷиши ҷойҳои холӣ ва сабти дархост" style="endArrow=block;html=1;rounded=0;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="510" as="sourcePoint"/><mxPoint x="1070" y="510" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m9" value="9. Натиҷаи санҷиш / ID-и дархост" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="550" as="sourcePoint"/><mxPoint x="745" y="550" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m10" value="10. Намоиши дархости нав" style="endArrow=block;html=1;rounded=0;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="590" as="sourcePoint"/><mxPoint x="1360" y="590" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m11" value="11. Қарори тасдиқ / рад" style="endArrow=block;html=1;rounded=0;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="630" as="sourcePoint"/><mxPoint x="745" y="630" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m12" value="12. Навсозии ҳолат ва таъини ҳуҷра (агар тасдиқ шавад)" style="endArrow=block;html=1;rounded=0;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="670" as="sourcePoint"/><mxPoint x="1070" y="670" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m13" value="13. Тасдиқи сабт" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="710" as="sourcePoint"/><mxPoint x="745" y="710" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m14" value="14. Огоҳинома дар бораи натиҷа" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="750" as="sourcePoint"/><mxPoint x="435" y="750" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="note" value="Эзоҳ: агар ҷойи холӣ набошад ё мудир дархостро рад кунад, система ҳолати дархостро «Радшуда» нигоҳ дошта, ба донишҷӯ огоҳинома мефиристад." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="220" y="805" width="1120" height="75" as="geometry"/></mxCell>
