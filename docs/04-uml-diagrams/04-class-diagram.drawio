        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#393C56;labelBackgroundColor=none;" value="CLASS DIAGRAM — Student Dormitory Management System (SDMS)" vertex="1">
